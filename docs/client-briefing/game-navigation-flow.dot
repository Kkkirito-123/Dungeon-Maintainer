digraph GameNavigationFlow {
  graph [
    rankdir=TB,
    bgcolor="#FCFCFA",
    pad=0.35,
    nodesep=0.38,
    ranksep=0.52,
    splines=polyline,
    fontname="PingFang SC",
    fontsize=20,
    label="缺少进入条件时：Agent 如何找到下一步",
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#64748B",
    penwidth=1.3,
    fontname="PingFang SC",
    fontsize=11,
    margin="0.16,0.10"
  ];
  edge [
    color="#64748B",
    penwidth=1.2,
    arrowsize=0.75,
    fontname="PingFang SC",
    fontsize=10
  ];

  blocked [
    label="角色尝试进入\n游戏提示缺少条件",
    fillcolor="#FDECEC",
    color="#B94A48"
  ];
  look [
    label="Agent 调用 look\n读取最新玩家投影",
    fillcolor="#E8F0FE",
    color="#3B6EA8"
  ];
  projection [
    label="游戏只返回当前决策信息\ntarget.kind · target.label\nprerequisites · actions · revision",
    fillcolor="#F1F5F9"
  ];
  target [
    label="是否已经公开\n前置条件目标？",
    shape=diamond,
    style="filled",
    fillcolor="#FFF4D6",
    color="#B7791F"
  ];
  known [
    label="目标类型示例\nprerequisite-reward / shortcut-key\nactionId = objective",
    fillcolor="#E9F7EF",
    color="#2E7D5B"
  ];
  frontier_available [
    label="是否提供 frontier\n探索动作？",
    shape=diamond,
    style="filled",
    fillcolor="#FFF4D6",
    color="#B7791F"
  ];
  explore [
    label="act(latestRevision, frontier, 64)\n沿已公开路径前往探索边界",
    fillcolor="#F4F0FA",
    color="#7656A3"
  ];
  navigate [
    label="act(latestRevision, objective, 64)\n游戏桥执行真实导航",
    fillcolor="#E9F7EF",
    color="#2E7D5B"
  ];
  reachable [
    label="目标是否仍可达？",
    shape=diamond,
    style="filled",
    fillcolor="#FFF4D6",
    color="#B7791F"
  ];
  refresh [
    label="返回 no-discovered-path\n或 target-not-visible\n重新 look 后改走 frontier",
    fillcolor="#FDECEC",
    color="#B94A48"
  ];
  interaction [
    label="抵达目标后重新 look\n取得新的交互 actionId\nact 执行领取/开锁/进入",
    fillcolor="#E9F7EF",
    color="#2E7D5B"
  ];
  acquired [
    label="条件满足\n玩家投影和可用动作更新",
    fillcolor="#E9F7EF",
    color="#2E7D5B",
    penwidth=1.6
  ];
  insufficient [
    label="语义接口信息不足\n明确报告阻塞\n不能猜测隐藏位置",
    fillcolor="#FDECEC",
    color="#B94A48"
  ];
  hidden [
    label="不会提供给 Agent\n完整地图 · 隐藏房间坐标\n正式存档 · 管理员答案 · judge",
    shape=note,
    style="filled,dashed",
    fillcolor="#FFFFFF",
    color="#B94A48",
    fontcolor="#7F1D1D"
  ];

  blocked -> look -> projection -> target;
  target -> known [label="是"];
  target -> frontier_available [label="否"];
  frontier_available -> explore [label="有"];
  frontier_available -> insufficient [label="没有"];
  explore -> look [label="到达新区域后重新观察"];
  known -> navigate -> reachable;
  reachable -> interaction [label="是"];
  reachable -> refresh [label="否"];
  refresh -> look;
  interaction -> acquired;
  projection -> hidden [
    label="安全边界",
    style=dashed,
    arrowhead=none,
    color="#B94A48",
    constraint=false
  ];
}
