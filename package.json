{
  "name": "dungeon-maintainer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "基于 Pi CLI Extension 的 SQL Dungeon 专用受限 Coding Agent",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "dungeon-maintain": "dist/src/main.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "pnpm build && node --test \"dist/tests/*.test.js\"",
    "test:smoke": "pnpm build && node --test dist/tests/evidence-smoke.test.js dist/tests/loop-guard.test.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "benchmark": "pnpm build && node dist/src/benchmark/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "playwright": "1.62.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "26.2.0",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
